# BertOS — always-on desktop host config.
# Copy this to the repo root as `.env` on the desktop and adjust if needed:
#   cp deploy/desktop/.env.desktop.example .env
#
# Exposure model: TAILSCALE-ONLY. Docker publishes the UI on loopback
# (127.0.0.1) only — NOT the LAN. `tailscale serve` (see DEPLOY-DESKTOP.md)
# then proxies it to your tailnet, so only your laptop/phone can reach it.

# --- Network -----------------------------------------------------------------
# Publish the container port to loopback only. Tailscale Serve exposes it to
# the tailnet; the LAN never sees it. (Do NOT set 0.0.0.0 unless you also turn
# AUTH_ENABLED on — see the "Whole LAN + login" alternative in the runbook.)
APP_BIND=127.0.0.1
APP_PORT=7777

# --- Single-user, no-login (safe behind Tailscale-only binding) --------------
AUTH_ENABLED=false
LOCALHOST_BYPASS=true
# Keep calendar/CalDAV on the same "" owner as email/memory/brief.
ODYSSEUS_FALLBACK_OWNER=

# --- Models: use the desktop's NATIVE Windows Ollama (RTX 3070) --------------
# host.docker.internal reaches the Windows host from the container. Make sure
# Ollama listens beyond loopback so the container can reach it:
#   set OLLAMA_HOST=0.0.0.0  (then restart Ollama)  — see runbook prerequisites.
LLM_HOST=localhost
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- Memory vault (bind-mounted at /vault by docker-compose.bertos.yml) -------
# Host path to the migrated vault. Default ./BertOS-Vault (next to the repo).
# The overlay sets BERTOS_OBSIDIAN_VAULT=/vault inside the container for you.
BERTOS_VAULT_DIR=./BertOS-Vault

# --- Daily brief → phone ------------------------------------------------------
# The reminder channel (ntfy) + topic are stored in data/settings.json, which
# you migrate from the laptop — nothing to set here. The bundled `ntfy`
# container is optional; the brief uses ntfy.sh by default.

# --- OPTIONAL: brain tools (Deep Build / Council via MCP) --------------------
# Reach the native bertosV2 brain on this host. Also uncomment the /brain mount
# and BERTOS_BRAIN_DIR in docker-compose.bertos.yml to enable the bridge.
BERTOS_BRAIN_BASE_URL=http://host.docker.internal:3000

# --- Search (bundled SearXNG container; leave as-is) -------------------------
# SEARXNG_SECRET is auto-generated by the searxng container on first boot.
